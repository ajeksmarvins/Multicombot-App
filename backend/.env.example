SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Backend only: secret key or legacy service_role key; NEVER put this in VITE_ variables.
SUPABASE_SERVICE_ROLE_KEY=
# Groq or another trusted OpenAI-compatible chat provider.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to a long random value (at least 32 characters), stable across restarts.
RATE_LIMIT_SECRET=
BOT_DAILY_LIMIT=100
